#!/usr/bin/env bash

# 1. OS and Python Detection
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
    PYTHON_CMD="python"
else
    # Try to find python with flake8 installed
    if python3.11 -m flake8 --version >/dev/null 2>&1; then
        PYTHON_CMD="python3.11"
    elif python3 -m flake8 --version >/dev/null 2>&1; then
        PYTHON_CMD="python3"
    else
        PYTHON_CMD="python3"
    fi
fi

echo "🛡️  Running pre-commit security and quality checks..."

# 2. High-Visibility Credential Detection
check_credentials() {
    local staged_files=$(git diff --cached --name-only)
    local found_bad_stuff=0
    local patterns=(
        # Generic variable names with key/secret/password/token + values
        "[a-zA-Z_]*[kK][eE][yY][a-zA-Z_]*[[:space:]]*[=:][[:space:]]*['\"][a-zA-Z0-9_/+=.-]{16,}"
        "[a-zA-Z_]*[sS][eE][cC][rR][eE][tT][a-zA-Z_]*[[:space:]]*[=:][[:space:]]*['\"][a-zA-Z0-9_/+=.-]{16,}"
        "[a-zA-Z_]*[tT][oO][kK][eE][nN][a-zA-Z_]*[[:space:]]*[=:][[:space:]]*['\"][a-zA-Z0-9_/+=.-]{16,}"
        "[a-zA-Z_]*[pP][aA][sS][sS][wW][oO][rR][dD][a-zA-Z_]*[[:space:]]*[=:][[:space:]]*['\"][^'\"]{8,}"
        "[a-zA-Z_]*[pP][aA][sS][sS][wW][dD][a-zA-Z_]*[[:space:]]*[=:][[:space:]]*['\"][^'\"]{8,}"
        # AWS Keys (specific format)
        "AKIA[0-9A-Z]{16}"
        "(aws[_-]?access|aws[_-]?secret)[a-zA-Z_]*[[:space:]]*[=:][[:space:]]*['\"][a-zA-Z0-9/+=]{20,}"
        # Private keys
        "BEGIN.*(PRIVATE|RSA|EC|DSA).*KEY"
        # OAuth and access tokens
        "(oauth|access|refresh)[_-]?token[a-zA-Z_]*[[:space:]]*[=:][[:space:]]*['\"][a-zA-Z0-9_.-]{20,}"
        # Database connection strings with credentials
        "(postgresql|mysql|mongodb|redis)://[^:]+:[^@/]+@"
        # GitHub Personal Access Tokens
        "gh[pousr]_[a-zA-Z0-9]{36,}"
        # Stripe API keys
        "(sk|pk)_(live|test)_[a-zA-Z0-9]{24,}"
        # Google API keys (typically start with AIza)
        "AIza[0-9A-Za-z_-]{35}"
        # Generic bearer tokens
        "[bB]earer[[:space:]]+[a-zA-Z0-9_.-]{20,}"
    )

    echo "🔐 Scanning for secrets and credentials..."

    for file in $staged_files; do
        [[ "$file" == *pre-commit* ]] && continue # Don't scan the hook itself
        [ ! -f "$file" ] && continue

        for pattern in "${patterns[@]}"; do
            local matches=$(git show ":$file" | grep -niE "$pattern")
            if [ ! -z "$matches" ]; then
                if [ $found_bad_stuff -eq 0 ]; then
                    echo ""
                    echo "╔═══════════════════════════════════════════════════════╗"
                    echo "║  🚨  SECURITY ALERT - SECRETS DETECTED  🚨           ║"
                    echo "╚═══════════════════════════════════════════════════════╝"
                    echo ""
                fi
                echo "📄 File: $file"
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                echo "$matches" | while IFS= read -r line; do
                    echo "   ⚠️  Line $line"
                done
                echo ""
                found_bad_stuff=1
            fi
        done
    done

    if [ $found_bad_stuff -ne 0 ]; then
        echo "❌ Commit blocked: Potential secrets found in staged files."
        echo "💡 Tip: Use environment variables or secret management tools."
        echo ""
    fi

    [ $found_bad_stuff -ne 0 ] && return 1 || return 0
}

# 3. Informative Code Quality Validation
validate_code_quality() {
    local staged_files=$(git diff --cached --name-only --diff-filter=ACM)
    local quality_violations=0
    local checked_files=0

    echo ""
    echo "🔍 Performing code quality validation..."
    echo ""

    for file in $staged_files; do
        if [[ "$file" == *.py ]]; then
            ((checked_files++))
            echo "🐍 Checking: $file"
            
            # Check if flake8 is actually installed
            if ! $PYTHON_CMD -m flake8 --version >/dev/null 2>&1; then
                echo "⚠️  [MISSING TOOL] flake8 not found. Running basic syntax check instead..."
                # Create temp file with staged content for syntax check
                local temp_file=$(mktemp)
                git show ":$file" > "$temp_file"
                if ! $PYTHON_CMD -m py_compile "$temp_file" 2>&1; then
                    ((quality_violations++))
                fi
                rm -f "$temp_file"
            else
                # Create temp file with staged content and run flake8 on it
                local temp_file=$(mktemp --suffix=.py)
                git show ":$file" > "$temp_file"
                $PYTHON_CMD -m flake8 "$temp_file" > /tmp/flake8_output.txt 2>&1
                local exit_code=$?
                if [ $exit_code -ne 0 ]; then
                    ((quality_violations++))
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    # Replace temp filename with actual filename in output
                    sed "s|$temp_file|$file|g" /tmp/flake8_output.txt | while IFS= read -r line; do
                        echo "   ⚠️  $line"
                    done
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                else
                    echo "   ✅ No issues found"
                fi
                rm -f "$temp_file" /tmp/flake8_output.txt
            fi
            echo ""
        fi
    done

    if [ $quality_violations -gt 0 ]; then
        echo ""
        echo "╔═══════════════════════════════════════════════════════╗"
        echo "║  ❌  CODE QUALITY ISSUES DETECTED  ❌                ║"
        echo "╚═══════════════════════════════════════════════════════╝"
        echo ""
        echo "📊 Summary: $quality_violations file(s) with issues out of $checked_files checked"
        echo "💡 Tip: Fix the issues above and try committing again."
        echo ""
        return 1
    else
        if [ $checked_files -gt 0 ]; then
            echo "✅ All $checked_files Python file(s) passed quality checks!"
        fi
    fi
    return 0
}

# Main execution flow - Run all checks and collect results
echo ""
echo "═══════════════════════════════════════════════════════════"
echo "   🛡️  PRE-COMMIT VALIDATION STARTED"
echo "═══════════════════════════════════════════════════════════"

credentials_failed=0
quality_failed=0

# Run credential check
check_credentials
if [ $? -ne 0 ]; then
    credentials_failed=1
fi

# Always run quality check, even if credentials failed
validate_code_quality
if [ $? -ne 0 ]; then
    quality_failed=1
fi

# Display final summary
echo "═══════════════════════════════════════════════════════════"
if [ $credentials_failed -eq 1 ] || [ $quality_failed -eq 1 ]; then
    echo "   ❌  COMMIT BLOCKED - Issues Found"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    [ $credentials_failed -eq 1 ] && echo "   🚨 Security check: FAILED"
    [ $quality_failed -eq 1 ] && echo "   🔍 Code quality: FAILED"
    echo ""
    echo "Please fix the issues above and try again."
    echo ""
    exit 1
else
    echo "   ✅  ALL CHECKS PASSED - Proceeding with commit"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
fi

exit 0